# Copy to a path outside git (e.g. /etc/bering/postgres-backup.env) and chmod 600.
#
#   sudo mkdir -p /etc/bering
#   sudo cp scripts/postgres-backup/postgres-backup.env.sample /etc/bering/postgres-backup.env
#   sudo chown "$USER:$USER" /etc/bering/postgres-backup.env   # required after sudo cp
#   chmod 600 /etc/bering/postgres-backup.env
#
# Cron example (on the host that runs Postgres):
#   15 3 * * * POSTGRES_BACKUP_ENV=/etc/bering/postgres-backup.env /home/andy/plistCSV/scripts/postgres-backup/backup-postgres.sh >> /var/log/plistcsv-pg-backup.log 2>&1

# --- Postgres (rotdb: generator tables + logbook schema) ---
# Option A: libpq vars (PGPASSWORD or ~/.pgpass)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGDATABASE=rotdb

# Option B: full URI (overrides PGHOST etc. when set)
# DATABASE_URL=postgres://postgres:SECRET@localhost:5432/rotdb

# Local staging before rsync to bering-vultr
BACKUP_DIR=/home/andy/backups
LOCAL_KEEP_COUNT=3

# Remote copy on Vultr
REMOTE_HOST=bering-vultr
REMOTE_DIR=/root/backup
REMOTE_KEEP_COUNT=7

# Filename prefix (files: rotdb-YYYY-MM-DD.sql.gz)
BACKUP_NAME_PREFIX=rotdb

# --- SSH (cron: set BACKUP_HOME) ---
BACKUP_HOME=/home/andy
SSH_CONFIG=/home/andy/.ssh/config
# Optional if ~/.ssh/config Host bering-vultr already sets IdentityFile
# SSH_IDENTITY_FILE=/home/andy/.ssh/id_ed25519_bering_vultr

# Optional: reuse fraBering rot-backup wrapper instead of the copy in this repo
# SSH_WRAPPER=/home/andy/fraBering/scripts/rot-backup/rot-backup-ssh.sh

MIN_FREE_GB=2

# ALERT_EMAIL=ops@example.com
